    {
      "datasource": {"type": "prometheus", "uid": "calltelemetry-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "title": "Dashboard HTTP 5xx rate",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(dash_api_prom_ex_phoenix_http_requests_total{job=\"dashboard\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "calltelemetry-prometheus"},
