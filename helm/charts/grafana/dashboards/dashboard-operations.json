      "targets": [{"expr": "kube_deployment_status_replicas_available{namespace=\"dashboard\",deployment=\"dashapi-dash-api\"}", "legendFormat": "available", "refId": "A"}, {"expr": "kube_deployment_spec_replicas{namespace=\"dashboard\",deployment=\"dashapi-dash-api\"}", "legendFormat": "desired", "refId": "B"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "calltelemetry-prometheus"},
