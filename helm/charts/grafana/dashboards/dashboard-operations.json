      "title": "Pod memory versus limit",
      "type": "timeseries",
      "targets": [{"expr": "100 * sum by (pod) (container_memory_working_set_bytes{namespace=\"dashboard\",container=\"dash-api\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"dashboard\",container=\"dash-api\",resource=\"memory\",unit=\"byte\"})", "legendFormat": "{{pod}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "calltelemetry-prometheus"},
