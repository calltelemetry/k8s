      "id": 3,
      "title": "Dashboard p95 latency",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(dash_api_prom_ex_phoenix_http_request_duration_milliseconds_bucket{job=\"dashboard\"}[5m]))) / 1000", "legendFormat": "p95", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "calltelemetry-prometheus"},
