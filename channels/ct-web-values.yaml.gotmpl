replicaCount: 1
environment: {{ .Values.channel.name | quote }}

vue_web:
  image:
    repository: {{ requiredEnv "CT_VUE_IMAGE_REPOSITORY" | quote }}
    tag: {{ requiredEnv "CT_VUE_IMAGE_TAG" | quote }}
    pullPolicy: IfNotPresent
  port: 80
  LogLevel: INFO

service:
  type: ClusterIP
  port: 80
  targetPort: 9000

ingress:
  enabled: true
  ingressClassName: {{ .Values.channel.ingress_class | quote }}
  annotations:
    haproxy.org/ssl-redirect: "true"
  hosts:
    - host: {{ .Values.channel.host | quote }}
      paths:
        - /
        - /#
  tls:
    - secretName: {{ .Values.channel.tls_secret | quote }}
      hosts:
        - {{ .Values.channel.host | quote }}

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi
